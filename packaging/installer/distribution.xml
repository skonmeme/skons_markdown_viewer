<?xml version="1.0" encoding="utf-8"?>
<!-- Installer package (STANDARD §10). `cargo xtask dist` replaces @VERSION@. -->
<installer-gui-script minSpecVersion="2">
    <title>INSTALLER_TITLE</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="26.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="skons_markdown_viewer"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="skons_markdown_viewer" visible="false">
        <pkg-ref id="skons_markdown_viewer"/>
    </choice>
    <pkg-ref id="skons_markdown_viewer" version="@VERSION@" onConclusion="none">app.pkg</pkg-ref>
</installer-gui-script>
